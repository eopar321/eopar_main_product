# Copy to apps/web/.env and apps/worker/.env for local development.
# Values here are for the LOCAL Docker services only. Never put real secrets in this file.

# Postgres (docker compose, host port 5433 — see docs/DECISIONS.md D-006)
DATABASE_URL=postgres://eopar:eopar_local_only@127.0.0.1:5433/eopar

# Redis (docker compose, host port 6380)
REDIS_URL=redis://:redis_local_only@127.0.0.1:6380

# Payload signing secret. Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public site URL (used for CSRF/CORS allow-list and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailpit (local SMTP catcher, inbox at http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ClamAV daemon
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
