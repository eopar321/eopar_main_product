{
  "name": "eopar",
  "private": true,
  "description": "EOPAR — Essence of Predictive Arts & Research",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
