{
  "name": "@eopar/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test"
  },
  "dependencies": {
    "@eopar/shared": "workspace:*",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-storybook": "10.6.5",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
